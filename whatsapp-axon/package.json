{
  "name": "@connectome/whatsapp-axon",
  "version": "0.1.0",
  "description": "WhatsApp AXON module for Connectome - bridges WhatsApp via Baileys to Connectome events and facets",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "start": "tsx src/grpc-main.ts",
    "start:dev": "nodemon --watch src --exec tsx src/grpc-main.ts"
  },
  "keywords": [
    "connectome",
    "axon",
    "whatsapp",
    "baileys",
    "chat",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@connectome/axon-interfaces": "workspace:*",
    "@connectome/grpc-common": "workspace:*",
    "@connectome/axon-binding": "workspace:*",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "dotenv": "^16.4.0",
    "pino": "^9",
    "sharp": "^0.34.5",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
